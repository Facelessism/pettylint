{
  "name": "pettylint",
  "version": "1.0.0",
  "description": "A lightweight, deterministic static-analysis engine for JavaScript/TypeScript that detects small, concrete, review-worthy code issues.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pettylint": "./bin/pettylint.js"
  },
  "main": "./dist-lib/core.js",
  "types": "./dist-lib/core.d.ts",
  "files": [
    "dist",
    "dist-lib",
    "bin",
    "action.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib && npm run build:action",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:action": "ncc build src/index.ts -o dist --minify && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'},null,2)+String.fromCharCode(10))\"",
    "pettylint": "tsx src/cli.ts"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "js-yaml": "^5.4.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vercel/ncc": "^0.45.0",
    "tsx": "^4.15.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Facelessism/pettylint.git"
  },
  "homepage": "https://github.com/Facelessism/pettylint#readme",
  "bugs": {
    "url": "https://github.com/Facelessism/pettylint/issues"
  }
}
